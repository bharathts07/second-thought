# Vendored ONNX runtime. Regenerated by the prebuild step from a pinned
# dependency, so tracking 12MB of binary would bloat history for no benefit.
public/wasm/

# Generated by the prebuild step from app/lib/worker.ts.
public/worker.js

# Scaffold agent-guidance files. This repo is public and does not attribute
# its code to any tool, so these are deliberately absent.
CLAUDE.md
AGENTS.md

# Vendored model weights, regenerated by the prebuild step.
public/models/

# Wrangler's local state and temp bundles. Created by `wrangler pages dev`, which is
# how the Cloudflare routing gets tested locally, and swept into a commit by a
# `git add -A`. Miniflare's sqlite caches and bundle shims are machine-local build
# residue: nothing here is a secret, and nothing here is useful to anyone cloning.
.wrangler/
